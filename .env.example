# Postgres (Neon) com a extensão pgvector habilitada. Sem isso, o scan cai
# automaticamente para o modo fixo (sem IA/RL) — mas nada quebra.
DATABASE_URL=postgresql://usuario:senha@host/hydradast?sslmode=require
HYDRA_DB_SCHEMA=public

# Usuário de demo usado pelos scripts standalone (main.py, input_classifier.py).
HYDRA_USER_NOME=Usuário Teste Hydra
HYDRA_USER_EMAIL=teste.hydradast@example.com
HYDRA_USER_SENHA_HASH=hash_temporario_substituir
HYDRA_USER_API_KEY=
HYDRA_USER_LIMITE=100
HYDRA_USER_ID=

# Geração do relatório final via LLM (Gemini). Sem isso, o relatório usa a
# base de conhecimento estática (ainda funcional).
GEMINI_API_KEY=

# Token usado por ataques_api.py para buscar wordlists no GitHub (SecLists etc).
Authorization=
